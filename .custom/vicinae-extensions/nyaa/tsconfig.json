{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 24",
  "include": ["src/**/*"],
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"]
  }
}
